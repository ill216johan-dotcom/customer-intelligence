# ==========================================
# Customer Intelligence Platform
# Environment Variables
# ==========================================

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=customer_intelligence
POSTGRES_USER=ci_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend
BACKEND_SECRET_KEY=CHANGE_ME_RANDOM_STRING_32_CHARS
BACKEND_DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# GLM-4 API (https://open.bigmodel.cn/)
GLM_API_KEY=your_glm_api_key_here

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# Telegram (Telethon)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+7XXXXXXXXXX

# Bitrix24
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_key/

# WMS API
WMS_API_URL=https://your-wms-api.com
WMS_API_KEY=your_wms_api_key

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# Whisper (local)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu  # or 'cuda' if GPU available
